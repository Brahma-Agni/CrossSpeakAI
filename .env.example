# Cross Speak AI — Environment Configuration
# Rename this file to .env and fill in your API keys.
# All five keys will be used with automatic failover on rate limits.

# Gemini API Keys (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY_1=your-gemini-api-key-1-here
GEMINI_API_KEY_2=your-gemini-api-key-2-here
GEMINI_API_KEY_3=your-gemini-api-key-3-here
GEMINI_API_KEY_4=your-gemini-api-key-4-here
GEMINI_API_KEY_5=your-gemini-api-key-5-here

# Optional: Override embedding model (defaults to all-MiniLM-L6-v2)
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Override Gemini LLM model
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase foundation (disabled preserves the current application)
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
